#sojust use the error term from earlier, "
dadaBell<-dada(filtBell, err=errF, multithread=TRUE) #def sees 10 samples here
seqtab2<-makeSequenceTable(dadaBell)
dim(seqtab2)
table(nchar(getSequences(seqtab2)))
#remove chimeras, eg the right side of one parent and left side of a different parent sequence
seqtab2.nochim<-removeBimeraDenovo(seqtab2,method="consensus",multithread=TRUE,verbose=TRUE)
sum(seqtab2.nochim)/sum(seqtab2)
getN <- function(x) sum(getUniques(x))
track2 <- cbind(outBell, sapply(dadaBell, getN), rowSums(seqtab2.nochim))
# If processing a single sample, remove the sapply calls: e.g. replace sapply(dadaFs, getN) with getN(dadaFs)
colnames(track2) <- c("input", "filtered", "denoisedF",  "nonchim")
rownames(track2) <- sample.names2
head(track2) #OK still 10 things, I do see where I'd goofed something earlier now fixed
#OK now I need an ITS2 or rbcL plant database which is available at https://figshare.com/articles/dataset/rbcL_July_2021/14936007?backTo=/collections/rbcL_reference_library_July_2021/5504193 for rbcL
#https://figshare.com/articles/dataset/ITS2_July_2021/14936004?backTo=/collections/ITS2_Reference_Library/5203703 for ITS2
taxa2 <- assignTaxonomy(seqtab2.nochim, "Bell_ea_2017/rbcL_plus_Nov2019adds_Jul2021corrections.dada2.fa", multithread=TRUE)
taxa2.print <- taxa2 # Removing sequence rownames for display only
rownames(taxa2.print) <- NULL
head(taxa2.print)
#BUTTTTT this seems to be only a single of the libraries instead of all 10?
ITStaxa <- assignTaxonomy(seqtab2.nochim, "Bell_ea_2017/Dada2_Reformatted_WithReference_Classes.NoDodgySeq.fasta",multithread=TRUE)
ITStaxa.print <- ITStaxa
rownames(ITStaxa.print)<-NULL
head(ITStaxa.print)
#I've already called phyloseq, Biostrings, ggplot2 and set theme to theme_bw
#requires thinking about structure of these
Bell.out<-rownames(seqtab2.nochim) #recovers the library names; in this case each library IS its own information so I don't need to do the subject, gender, etc
ps2<-phyloseq(otu_table(seqtab2.nochim,taxa_are_rows=FALSE),tax_table(taxa2)) #rbcL
psITS<-phyloseq(otu_table(seqtab2.nochim,taxa_are_rows=FALSE),tax_table(ITStaxa)) #ITS2
dna2<-Biostrings::DNAStringSet(taxa_names(ps2))
names(dna2)<-taxa_names(ps2)
ps2<-merge_phyloseq(ps2,dna2)
taxa_names(ps2)<-paste0("ASV",seq(ntaxa(ps2)))
ps2
dnaITS<-Biostrings::DNAStringSet(taxa_names(psITS))
names(dnaITS)<-taxa_names(psITS)
psITS<-merge_phyloseq(psITS,dnaITS)
taxa_names(psITS)<-paste0("ASV",seq(ntaxa(psITS)))
psITS
