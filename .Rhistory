knitr::opts_chunk$set(echo = TRUE)
library(pegas)
library(ape) #these are both common packages for manipulation and analysis of DNA sequences
library(poppr)
seqs<-read.FASTA("AllGeukRADstudy.fasta") #DNAbin
#these are mtDNA haplotypes from 2 species of ribbed mussels in the southeastern US
dists<-dist.dna(seqs,model="raw",pairwise.deletion=TRUE, as.matrix=TRUE) #you may want as.matrix TRUE
View(dists) #so can see pairwise matrix. Note that this is out of 537 bp of aligned sequence.
#ok for poppr.amova need genind, which will let you set populations, but that comes from adegenet
#and adegenet has a DNAbin2genind
geukpops<-c("tampa","tampa","tampa","tampa","wakulla","wakulla","ponce","wakulla","tampa","tampa","wakulla","wakulla","wakulla","tampa","wakulla","tampa","wakulla","ponce","worth","worth","bikepath","worth","worth","worth","ponce","savannah","savannah","savannah","whitney","bikepath","worth","worth","ponce","ponce","ponce","lowdean","lowdean","lowdean","lowdean","whitney","whitney","whitney","whitney","whitney","savannah","savannah","savannah","savannah","ponce","ponce","bikepath","bikepath","lowdean","savannah","ponce","bikepath","savannah","bikepath","bikepath","bikepath","worth","ponce","lowdean","whitney","bikepath","lowdean","whitney","lowdean","whitney","worth","lowdean","ponce","whitney","ponce","bikepath","bikepath","savannah","bikepath","bikepath","bikepath","bikepath","worth","worth","worth","worth","worth","ponce","lowdean","whitney","whitney","savannah","ponce","bikepath","ponce","lowdean","lowdean","whitney","ponce","bikepath") #fixed but need to auto-generate in future
# steal code from LearningDada to get it to auto-generate the pops? Or have people import population/region files
geuk<-DNAbin2genind(seqs,pop=geukpops,exp.char=c("a","t","g","c"))
#i mean i guess that makes sense, 95 variable sites and some of them have 3 alleles...
regions<-geukpops #how replace individual terms in there with "grano","southeast","northeast" etc
#rewrite this better given change in order above
# NEED TO MAKE A DF THAT INCLUDES REGIONS AND POPS
library(stringr)
regions<-str_replace(regions,"wakulla","1")
regions<-str_replace(regions,"tampa","1")
regions<-str_replace(regions,"worth","2")
regions<-str_replace(regions,"ponce","2")
regions<-str_replace(regions,"whitney","2")
regions<-str_replace(regions,"bikepath","2")
regions<-str_replace(regions,"lowdean","2")
regions<-str_replace(regions,"savannah","2")
regions<-as.data.frame(regions)
regions$pops<-geukpops
geuk@strata<-regions
output<-poppr.amova(geuk,hier=~regions/pops,nperm=2000)
library(ade4)
outtest <- randtest(output,nrepet=999)
plot(outtest)
outtest
#output gives you the metrics
#outtest gives you the stats
