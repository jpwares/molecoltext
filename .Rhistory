unique_colnames<-unique(colnames(testtableITS))
ITS2<-list()
for(col_name in unique_colnames) {
cols_to_sum<-which(colnames(testtableITS)==col_name)
ITS2[[col_name]]<-rowSums(testtableITS[,cols_to_sum,drop=FALSE], na.rm=TRUE)
}
ITS2<-as.data.frame(ITS2)
