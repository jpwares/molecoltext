library(dplyr)
colnames(testtable)[is.na(colnames(testtable))]<-"Unknown"
unique_colnames<-unique(colnames(testtable))
rbcL<-list()
#rbcL<-data.frame(matrix(ncol=length(unique_colnames),nrow=nrow(testtable)))
for(col_name in unique_colnames) {
cols_to_sum<-which(colnames(testtable)==col_name)
rbcL[[col_name]]<-rowSums(testtable[,cols_to_sum,drop=FALSE], na.rm=TRUE)
}
